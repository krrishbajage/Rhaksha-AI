# Gemini (required — Message Agent and Explanation Agent need this to function)
GOOGLE_API_KEY=
# Fallback for any LLM node without a dedicated pool.
GEMINI_MODEL=gemini-3.6-flash
# Each active LLM agent has its own primary model and a bounded overflow model.
# Put models with exhausted daily quotas at the end or remove them until their quota resets.
GEMINI_MODELS_MESSAGE_AGENT=gemini-3.1-flash-lite,gemini-3.7-flash
GEMINI_MODELS_EXPLANATION_AGENT=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional future pools: current planner, URL, attachment and risk nodes are deterministic/tool-based.
# GEMINI_MODELS_PLANNER=gemini-3.1-flash-lite
# GEMINI_MODELS_URL_AGENT=gemini-3.7-flash
# GEMINI_MODELS_ATTACHMENT_AGENT=gemini-3.6-flash
# GEMINI_MODELS_RISK_ENGINE=gemini-3-flash
# Per-model RPM budgets; set only to values confirmed in your own AI Studio account.
GEMINI_MODEL_RPM=gemini-3.7-flash:5,gemini-3.5-flash-lite:15,gemini-3.1-flash-lite:15
MAX_CONCURRENT_ANALYSES=5
MAX_ANALYSIS_QUEUE_WAIT_SECONDS=180
MAX_CONCURRENT_LLM_REQUESTS=5
# Fallback RPM for a model not listed in GEMINI_MODEL_RPM.
MAX_LLM_REQUESTS_PER_MINUTE=10
GEMINI_TIMEOUT_SECONDS=25
# Change model on a 429 instead of retrying the same exhausted model.
GEMINI_RETRY_COUNT=0
GEMINI_RETRY_BASE_SECONDS=1
GEMINI_MODEL_COOLDOWN_SECONDS=60

# Google Safe Browsing (optional — stubbed with "unknown" result if left empty)
SAFE_BROWSING_API_KEY=

# VirusTotal (optional — stubbed with "unknown" result if left empty)
VIRUSTOTAL_API_KEY=


# Environment
ENVIRONMENT=development


# Database (used by docker-compose postgres service; not required for /analyze yet)
DATABASE_URL=postgresql://raksha:raksha@db:5432/raksha

# Backend server settings
HOST=0.0.0.0
PORT=8000
